<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.*" />
    <PackageReference Include="Google.Protobuf" Version="3.*" />
    <PackageReference Include="Grpc.Tools" Version="2.*" PrivateAssets="All" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.*" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Services\Wardrobe\Wardrobe.Api\Protos\wardrobe.proto" GrpcServices="Client" />
    <Protobuf Include="..\Services\Recommendations\Recommendations.Api\Protos\recommendations.proto" GrpcServices="Client" />
    <Protobuf Include="..\Services\Feedback\Feedback.WebApi\Protos\feedback.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
