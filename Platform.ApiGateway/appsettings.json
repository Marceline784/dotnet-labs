{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 0,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "Metadata": {
          "Team": "platform",
          "Version": "v1"
        }
      },
      "users-laundry": {
        "ClusterId": "wardrobe",
        "Order": 0,
        "Match": {
          "Path": "/api/users/{userId:long}/laundry"
        },
        "Metadata": {
          "Team": "wardrobe",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "recommendations": {
        "ClusterId": "recommendations",
        "Order": 10,
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        },
        "Metadata": {
          "Team": "recommendations",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "outfits": {
        "ClusterId": "recommendations",
        "Order": 10,
        "Match": {
          "Path": "/api/outfits/{**catch-all}"
        },
        "Metadata": {
          "Team": "recommendations",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "users": {
        "ClusterId": "recommendations",
        "Order": 10,
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Metadata": {
          "Team": "recommendations",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "wardrobe-items": {
        "ClusterId": "wardrobe",
        "Order": 10,
        "Match": {
          "Path": "/api/wardrobe-items/{**catch-all}"
        },
        "Metadata": {
          "Team": "wardrobe",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "categories": {
        "ClusterId": "wardrobe",
        "Order": 10,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "wardrobe",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      },
      "feedback": {
        "ClusterId": "feedback",
        "Order": 10,
        "Match": {
          "Path": "/api/feedback/{**catch-all}"
        },
        "Metadata": {
          "Team": "feedback",
          "Version": "v1"
        },
        "MaxRequestBodySize": 1048576
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "recommendations": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://recommendations-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "wardrobe": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://wardrobe-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "feedback": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://feedback-api"
          }
        }
      }
    }
  }
}